try:
    file = open("students.txt", "r")

    lines = file.readlines()

    line_count = len(lines)
    word_count = 0

    for line in lines:
        word_count += len(line.split())

    print("Total Lines:", line_count)
    print("Total Words:", word_count)

    file.close()

except FileNotFoundError:
    print("File not found!")
