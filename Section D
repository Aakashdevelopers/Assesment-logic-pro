def frequency_count(arr):
    freq = {}

    for num in arr:
        if num in freq:
            freq[num] += 1
        else:
            freq[num] = 1

    print("Frequency:", freq)

    most_frequent = max(freq, key=freq.get)

    print("Most Frequent Number:", most_frequent)
    print("Frequency:", freq[most_frequent])


arr = [4, 2, 4, 3, 2, 4, 1]

frequency_count(arr)

