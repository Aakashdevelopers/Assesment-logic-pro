def check_pattern(arr):
    diff = arr[1] - arr[0]

    for i in range(1, len(arr) - 1):
        if arr[i + 1] - arr[i] != diff:
            return False

    return True


numbers = [2, 4, 6, 8, 10, 12]

print(check_pattern(numbers))

